# Copy to .env on the server and chmod 600 it.
# Generate the token with: openssl rand -hex 32
SYNC_API_TOKEN=

# Option A (Recommended for Claude Pro subscribers — $0 extra API cost):
# Install Claude Code CLI (`npm install -g @anthropic-ai/claude-code`) and run `claude login`
# with your Claude Pro account. Leave ANTHROPIC_API_KEY empty and set CLAUDE_PRO_CLI=1.
CLAUDE_PRO_CLI=1

# Option B (Paid per-token Anthropic Console API key — leave empty if using Claude Pro):
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
